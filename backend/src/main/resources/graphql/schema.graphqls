type Query {
    assets(limit: Int = 10): [Asset!]!
    loans: [Loan!]!
    users(limit: Int = 10): [User!]!
    maintenanceRecords: [MaintenanceRecord!]!
    myLoanHistory: [Loan!]!
    auditLogs(
        serialNumber: String
        technicianId: ID
        startDate: String
        endDate: String
        status: LoanStatus
        page: Int = 0
        limit: Int = 20
    ): LoanAuditPage!
    dashboardMetrics(startDate: String, endDate: String): LoanDashboardMetrics!
    lostAssetReports: [LostAssetReport!]!
    providers: [Provider!]!
}

type Mutation {
    login(input: LoginInput!): LoginPayload!
    requestPasswordReset(email: String!): PasswordResetPayload!
    createAsset(input: AssetInput!): Asset!
    updateAsset(input: UpdateAssetInput!): Asset!
    createUser(input: UserInput!): User!
    updateUser(input: UpdateUserInput!): User!
    uploadAssetsBulk(input: BulkUploadInput!): BulkUploadPayload!
    requestLoan(input: RequestLoanInput!): Loan!
    approveLoan(input: ApproveLoanInput!): Loan!
    rejectLoan(input: RejectLoanInput!): Loan!
    returnLoan(input: ReturnLoanInput!): Loan!
    createMaintenanceRecord(input: MaintenanceRecordInput!): MaintenanceRecord!
    completeMaintenance(input: CompleteMaintenanceInput!): MaintenanceRecord!
    updateMaintenanceRecord(input: UpdateMaintenanceRecordInput!): MaintenanceRecord!
    decommissionFromMaintenance(id: ID!, notes: String!): MaintenanceRecord!
    createProvider(name: String!): Provider!
    acknowledgeLostAssetReport(id: ID!): LostAssetReport!
}

type LoginPayload {
    token: String!
    user: User!
}

type PasswordResetPayload {
    message: String!
}

type BulkUploadPayload {
    importedCount: Int!
    assets: [Asset!]!
}

enum LoanStatus {
    PENDING
    APPROVED
    REJECTED
    RETURNED
}

enum ReturnCondition {
    GOOD
    DAMAGED
    LOST
}

type User {
    id: ID!
    fullName: String
    email: String
    role: String
    status: Boolean
}

type Asset {
    id: ID!
    serialNumber: String!
    model: String
    estimatedValue: Float
    status: String!
    purchaseDate: String
    stockQuantity: Int
    availableQuantity: Int!
}

type Loan {
    id: ID!
    requestDate: String
    dueLocalDate: String
    returnDateTime: String
    status: LoanStatus
    returnCondition: ReturnCondition
    delayDays: Int
    user: User
    asset: Asset
    inspector: User
    rejectionReason: String
}

type LoanAuditPage {
    loans: [Loan!]!
    totalElements: Int!
    page: Int!
    limit: Int!
    totalPages: Int!
}

type LoanDashboardMetrics {
    estimatedLossValue: Float!
    maintenanceCostsValue: Float!
    onTimeReturnPercentage: Float!
    assetsCurrentlyInField: Int!
    totalAssets: Int!
    availableAssets: Int!
    assetsUnderMaintenance: Int!
    lostAssets: Int!
    assetsByModel: [AssetModelMetrics!]!
}

type AssetModelMetrics {
    model: String!
    total: Int!
    available: Int!
}

type MaintenanceRecord {
    id: ID!
    asset: Asset
    provider: Provider
    providerName: String
    reason: String
    cost: Float
    startDate: String
    endDate: String
}

type Provider {
    id: ID!
    name: String!
    active: Boolean!
}

type LostAssetReport {
    id: ID!
    asset: Asset!
    loan: Loan
    reportedByUser: User
    reportedAt: String!
    notes: String
    acknowledged: Boolean!
}

input AssetInput {
    serialNumber: String
    model: String
    estimatedValue: Float
    status: String!
    purchaseDate: String
    stockQuantity: Int
    loanTechnicianId: ID
    loanStartDate: String
    loanDueDate: String
    loanStartTime: String
    loanEndTime: String
    maintenanceReason: String
    maintenanceCost: Float
    maintenanceProviderName: String
    lostNotes: String
}

input UpdateAssetInput {
    id: ID!
    serialNumber: String
    model: String
    estimatedValue: Float
    status: String!
    purchaseDate: String
    stockQuantity: Int
    loanTechnicianId: ID
    loanStartDate: String
    loanDueDate: String
    loanStartTime: String
    loanEndTime: String
    maintenanceReason: String
    maintenanceCost: Float
    maintenanceProviderName: String
    lostNotes: String
}

input UserInput {
    fullName: String!
    email: String!
    password: String!
    role: String!
    status: Boolean!
}

input UpdateUserInput {
    id: ID!
    fullName: String!
    email: String!
    password: String
    role: String!
    status: Boolean!
}

input CompleteMaintenanceInput {
    recordId: ID!
}

input UpdateMaintenanceRecordInput {
    recordId: ID!
    providerId: ID
    providerName: String
    reason: String
    cost: Float
}

input LoginInput {
    email: String!
    password: String!
}

input BulkUploadInput {
    filename: String!
    contentBase64: String!
}

input RequestLoanInput {
    assetId: ID!
    dueDate: String!
    startDate: String
    startTime: String
    endTime: String
}

input ApproveLoanInput {
    loanId: ID!
}

input RejectLoanInput {
    loanId: ID!
    reason: String!
}

input ReturnLoanInput {
    loanId: ID!
    condition: ReturnCondition!
    damageDescription: String
    notes: String
}

input MaintenanceRecordInput {
    assetId: ID!
    providerId: ID
    providerName: String
    reason: String
    cost: Float
    startDate: String
    endDate: String
}
